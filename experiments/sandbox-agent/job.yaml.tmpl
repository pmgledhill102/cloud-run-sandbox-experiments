# Cloud Run job for the sandbox-agent POC. Rendered by run.sh: PROJECT, IMAGE.
apiVersion: run.googleapis.com/v1
kind: Job
metadata:
  name: sandbox-agent-poc
  labels:
    cloud.googleapis.com/location: europe-west1
  annotations:
    run.googleapis.com/launch-stage: BETA
spec:
  template:
    spec:
      taskCount: 1
      template:
        spec:
          serviceAccountName: agent-job@${PROJECT}.iam.gserviceaccount.com
          timeoutSeconds: 1200
          maxRetries: 0
          containers:
            - name: agent
              image: ${IMAGE}
              args: ["attack"]
              sandboxLauncher: true
              resources:
                limits:
                  cpu: "2"
                  memory: 8Gi
